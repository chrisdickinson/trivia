#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BIN="${PLUGIN_ROOT}/bin/trivia"

# Install on demand so MCP startup doesn't depend on the SessionStart hook
# having already run. stdout is the MCP channel — keep installer noise off it.
if [ ! -x "$BIN" ]; then
  "${PLUGIN_ROOT}/scripts/install" >&2
fi

exec "$BIN" "$@"
