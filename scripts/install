#!/usr/bin/env bash
set -euo pipefail

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
BIN_DIR="${PLUGIN_ROOT}/bin"
BIN="${BIN_DIR}/trivia"

# If binary already exists and is executable, we're done
if [ -x "$BIN" ]; then
  exit 0
fi

# Detect platform
OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$ARCH" in
  x86_64)  ARCH="x86_64" ;;
  aarch64|arm64) ARCH="aarch64" ;;
  *) echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

case "$OS" in
  linux)  TARGET="${ARCH}-unknown-linux-gnu" ;;
  darwin) TARGET="${ARCH}-apple-darwin" ;;
  msys*|mingw*|cygwin*)
    exec powershell.exe -ExecutionPolicy Bypass -File "${PLUGIN_ROOT}/scripts/install.ps1"
    ;;
  *) echo "Unsupported OS: $OS" >&2; exit 1 ;;
esac

mkdir -p "$BIN_DIR"

REPO="chrisdickinson/trivia"

# Prefer the release matching this plugin checkout; fall back to latest.
VERSION="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "${PLUGIN_ROOT}/.claude-plugin/plugin.json" 2>/dev/null | head -1 || true)"
URLS=()
if [ -n "$VERSION" ]; then
  URLS+=("https://github.com/${REPO}/releases/download/v${VERSION}/trivia-${TARGET}.tar.gz")
fi
URLS+=("https://github.com/${REPO}/releases/latest/download/trivia-${TARGET}.tar.gz")

if command -v curl &>/dev/null; then
  # Stage inside bin/ so the final mv is a same-filesystem rename — concurrent
  # installs (SessionStart hook + MCP wrapper) can't clobber a half-written binary.
  STAGE="$(mktemp -d "${BIN_DIR}/.install.XXXXXX")"
  trap 'rm -rf "$STAGE"' EXIT

  for URL in "${URLS[@]}"; do
    if curl -fsSL -o "${STAGE}/release.tar.gz" "$URL" 2>/dev/null; then
      tar -xzf "${STAGE}/release.tar.gz" -C "$STAGE"
      chmod +x "${STAGE}/trivia"
      mv -f "${STAGE}/trivia" "$BIN"
      exit 0
    fi
  done
fi

# Fallback: build from source
if command -v cargo &>/dev/null; then
  echo "Building trivia from source..." >&2

  # Build web UI if npm is available and dist doesn't exist
  WWW_DIR="${PLUGIN_ROOT}/apps/cli/www"
  if [ ! -d "${WWW_DIR}/dist" ] && command -v npm &>/dev/null; then
    (cd "$WWW_DIR" && npm ci && npm run build) >&2
  fi

  cargo build --manifest-path "${PLUGIN_ROOT}/apps/cli/Cargo.toml" --release --quiet
  cp "${PLUGIN_ROOT}/target/release/trivia" "${BIN}.tmp.$$"
  chmod +x "${BIN}.tmp.$$"
  mv -f "${BIN}.tmp.$$" "$BIN"
  exit 0
fi

echo "Error: could not install trivia. Install cargo or download a release." >&2
exit 1
